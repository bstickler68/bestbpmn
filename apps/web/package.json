{
  "name": "@bestbpmn/web",
  "version": "0.1.0",
  "private": true,
  "description": "bestbpmn als Web-App: bpmn-js mit Prozessstatus, RACI/DEMI und Prüfregeln",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @bestbpmn/model -w @bestbpmn/i18n",
    "dev": "vite",
    "prebuild": "npm run build -w @bestbpmn/model -w @bestbpmn/i18n",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --mode single",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:single": "vite build --mode single",
    "release": "npm run build && node scripts/release.mjs"
  },
  "dependencies": {
    "@bestbpmn/bpmn-js-extension": "0.1.0",
    "@bestbpmn/i18n": "0.1.0",
    "@bestbpmn/model": "0.1.0",
    "@bpmn-io/properties-panel": "3.57.1",
    "bpmn-js": "18.31.1",
    "bpmn-js-properties-panel": "5.65.2"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
