{
  "name": "bestbpmn",
  "short_name": "bestbpmn",
  "description": "BPMN-Modellierer mit Prozessstatus, DEMI-Matrix und Berichten",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0969da",
  "lang": "de",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/xml": [".bpmn"] } }
  ]
}
