<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:raci="urn:bestadd:raci:1.0"
                  xmlns:bestadd="urn:bestadd:schema:1.0"
                  id="Definitions_Incident"
                  bestadd:language="de"
                  targetNamespace="urn:bestadd:templates">
  <bpmn:collaboration id="Collaboration_Incident" name="Incident bearbeiten">
    <bpmn:participant id="Pool_Incident" name="IT-Service" processRef="Incident" />
  </bpmn:collaboration>
  <bpmn:process id="Incident" name="Incident bearbeiten" isExecutable="true">
    <bpmn:documentation textFormat="text/markdown">Ein Incident kann auf drei Wegen entstehen: aus einer E-Mail an den Service-Desk, durch die Person selbst oder telefonisch über den Service-Desk. Jeder Weg setzt den Anfangsstatus über seine erste Aktivität mit Status.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Incident">
      <bpmn:lane id="Lane_Anwender" name="Anwender" raci:assignee="group(users)">
        <bpmn:flowNodeRef>Start_Selbst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Selbst_erfassen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceDesk" name="Service-Desk" raci:assignee="group(service_desk)">
        <bpmn:flowNodeRef>Start_Mail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aus_Mail_anlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Anruf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Anruf_annehmen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Telefonisch_erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Zusammenfuehren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Loesung_pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2ndLevel" name="2nd-Level-Support" raci:assignee="group(second_level)">
        <bpmn:flowNodeRef>Bearbeiten</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="Prozess" name="Prozess" />
    <bpmn:dataObjectReference id="Ref_Neu" name="Prozess [new]" dataObjectRef="Prozess">
      <bpmn:dataState id="State_Neu" bestadd:key="new" name="new" />
    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="Ref_Geloest" name="Prozess [resolved]" dataObjectRef="Prozess">
      <bpmn:dataState id="State_Geloest" bestadd:key="resolved" name="resolved" />
    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="Ref_Geschlossen" name="Prozess [closed]" dataObjectRef="Prozess">
      <bpmn:dataState id="State_Geschlossen" bestadd:key="closed" name="closed" />
    </bpmn:dataObjectReference>

    <bpmn:startEvent id="Start_Selbst" name="Störung bemerkt"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="Start_Mail" name="E-Mail eingegangen"><bpmn:outgoing>F3</bpmn:outgoing><bpmn:messageEventDefinition id="Msg_Mail" /></bpmn:startEvent>
    <bpmn:startEvent id="Start_Anruf" name="Anruf eingegangen"><bpmn:outgoing>F5</bpmn:outgoing></bpmn:startEvent>

    <bpmn:userTask id="Selbst_erfassen" name="Incident selbst erfassen">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Out_Selbst_erfassen"><bpmn:targetRef>Ref_Neu</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:potentialOwner id="Owner_Selbst_erfassen"><bpmn:resourceAssignmentExpression id="Expr_Selbst_erfassen"><bpmn:formalExpression id="Formal_Selbst_erfassen">group(users)</bpmn:formalExpression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>
    </bpmn:userTask>
    <bpmn:serviceTask id="Aus_Mail_anlegen" name="Incident aus E-Mail anlegen">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Out_Aus_Mail_anlegen"><bpmn:targetRef>Ref_Neu</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:potentialOwner id="Owner_Aus_Mail_anlegen"><bpmn:resourceAssignmentExpression id="Expr_Aus_Mail_anlegen"><bpmn:formalExpression id="Formal_Aus_Mail_anlegen">group(service_desk)</bpmn:formalExpression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Anruf_annehmen" name="Anruf annehmen">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:documentation textFormat="text/markdown">Manuelle Tätigkeit ohne Status. Den Anfangsstatus setzt erst „Incident telefonisch erfassen“.</bpmn:documentation>
      <bpmn:potentialOwner id="Owner_Anruf_annehmen"><bpmn:resourceAssignmentExpression id="Expr_Anruf_annehmen"><bpmn:formalExpression id="Formal_Anruf_annehmen">group(service_desk)</bpmn:formalExpression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>
    </bpmn:manualTask>
    <bpmn:userTask id="Telefonisch_erfassen" name="Incident telefonisch erfassen">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Out_Telefonisch_erfassen"><bpmn:targetRef>Ref_Neu</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:potentialOwner id="Owner_Telefonisch_erfassen"><bpmn:resourceAssignmentExpression id="Expr_Telefonisch_erfassen"><bpmn:formalExpression id="Formal_Telefonisch_erfassen">group(service_desk)</bpmn:formalExpression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Zusammenfuehren">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Bearbeiten" name="Incident bearbeiten">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:extensionElements>
        <raci:accountable><raci:role ref="incident_manager" /></raci:accountable>
        <raci:informed><raci:group ref="service_desk" /></raci:informed>
      </bpmn:extensionElements>
      <bpmn:dataOutputAssociation id="Out_Bearbeiten"><bpmn:targetRef>Ref_Geloest</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:potentialOwner id="Owner_Bearbeiten"><bpmn:resourceAssignmentExpression id="Expr_Bearbeiten"><bpmn:formalExpression id="Formal_Bearbeiten">group(second_level)</bpmn:formalExpression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>
    </bpmn:userTask>
    <bpmn:userTask id="Loesung_pruefen" name="Lösung prüfen">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:documentation textFormat="text/markdown">Multi-Instanz-Aufgabe: Service-Desk und Incident-Manager prüfen parallel, jede Rolle prüft für sich.</bpmn:documentation>
      <bpmn:dataOutputAssociation id="Out_Loesung_pruefen"><bpmn:targetRef>Ref_Geschlossen</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:potentialOwner id="Owner_Loesung_pruefen"><bpmn:resourceAssignmentExpression id="Expr_Loesung_pruefen"><bpmn:formalExpression id="Formal_Loesung_pruefen">group(service_desk), role(incident_manager)</bpmn:formalExpression></bpmn:resourceAssignmentExpression></bpmn:potentialOwner>
      <bpmn:multiInstanceLoopCharacteristics id="MI_Loesung_pruefen" />
    </bpmn:userTask>
    <bpmn:endEvent id="Ende" name="Incident geschlossen"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Selbst" targetRef="Selbst_erfassen" />
    <bpmn:sequenceFlow id="F2" sourceRef="Selbst_erfassen" targetRef="Zusammenfuehren" />
    <bpmn:sequenceFlow id="F3" sourceRef="Start_Mail" targetRef="Aus_Mail_anlegen" />
    <bpmn:sequenceFlow id="F4" sourceRef="Aus_Mail_anlegen" targetRef="Zusammenfuehren" />
    <bpmn:sequenceFlow id="F5" sourceRef="Start_Anruf" targetRef="Anruf_annehmen" />
    <bpmn:sequenceFlow id="F6" sourceRef="Anruf_annehmen" targetRef="Telefonisch_erfassen" />
    <bpmn:sequenceFlow id="F7" sourceRef="Telefonisch_erfassen" targetRef="Zusammenfuehren" />
    <bpmn:sequenceFlow id="F8" sourceRef="Zusammenfuehren" targetRef="Bearbeiten" />
    <bpmn:sequenceFlow id="F9" sourceRef="Bearbeiten" targetRef="Loesung_pruefen" />
    <bpmn:sequenceFlow id="F10" sourceRef="Loesung_pruefen" targetRef="Ende" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Incident">
    <bpmndi:BPMNPlane id="Plane_Incident" bpmnElement="Collaboration_Incident">
      <bpmndi:BPMNShape id="Pool_Incident_di" bpmnElement="Pool_Incident" isHorizontal="true"><dc:Bounds x="120" y="60" width="1000" height="510" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Anwender_di" bpmnElement="Lane_Anwender" isHorizontal="true"><dc:Bounds x="150" y="60" width="970" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ServiceDesk_di" bpmnElement="Lane_ServiceDesk" isHorizontal="true"><dc:Bounds x="150" y="200" width="970" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2ndLevel_di" bpmnElement="Lane_2ndLevel" isHorizontal="true"><dc:Bounds x="150" y="420" width="970" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Selbst_di" bpmnElement="Start_Selbst"><dc:Bounds x="192" y="112" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Selbst_erfassen_di" bpmnElement="Selbst_erfassen"><dc:Bounds x="270" y="90" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Mail_di" bpmnElement="Start_Mail"><dc:Bounds x="192" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Aus_Mail_anlegen_di" bpmnElement="Aus_Mail_anlegen"><dc:Bounds x="270" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Anruf_di" bpmnElement="Start_Anruf"><dc:Bounds x="192" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anruf_annehmen_di" bpmnElement="Anruf_annehmen"><dc:Bounds x="270" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Telefonisch_erfassen_di" bpmnElement="Telefonisch_erfassen"><dc:Bounds x="410" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Zusammenfuehren_di" bpmnElement="Zusammenfuehren" isMarkerVisible="true"><dc:Bounds x="555" y="225" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bearbeiten_di" bpmnElement="Bearbeiten"><dc:Bounds x="650" y="455" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Loesung_pruefen_di" bpmnElement="Loesung_pruefen"><dc:Bounds x="800" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende_di" bpmnElement="Ende"><dc:Bounds x="962" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ref_Neu_di" bpmnElement="Ref_Neu"><dc:Bounds x="500" y="95" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ref_Geloest_di" bpmnElement="Ref_Geloest"><dc:Bounds x="560" y="470" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ref_Geschlossen_di" bpmnElement="Ref_Geschlossen"><dc:Bounds x="857" y="100" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="228" y="130" /><di:waypoint x="270" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="370" y="130" /><di:waypoint x="420" y="130" /><di:waypoint x="420" y="180" /><di:waypoint x="580" y="180" /><di:waypoint x="580" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="228" y="250" /><di:waypoint x="270" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="370" y="250" /><di:waypoint x="555" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="228" y="360" /><di:waypoint x="270" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="370" y="360" /><di:waypoint x="410" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="510" y="360" /><di:waypoint x="580" y="360" /><di:waypoint x="580" y="275" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="605" y="250" /><di:waypoint x="700" y="250" /><di:waypoint x="700" y="455" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="750" y="495" /><di:waypoint x="850" y="495" /><di:waypoint x="850" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="900" y="250" /><di:waypoint x="962" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Out_Selbst_erfassen_di" bpmnElement="Out_Selbst_erfassen"><di:waypoint x="370" y="110" /><di:waypoint x="500" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Out_Aus_Mail_anlegen_di" bpmnElement="Out_Aus_Mail_anlegen"><di:waypoint x="350" y="210" /><di:waypoint x="506" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Out_Telefonisch_erfassen_di" bpmnElement="Out_Telefonisch_erfassen"><di:waypoint x="490" y="320" /><di:waypoint x="524" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Out_Bearbeiten_di" bpmnElement="Out_Bearbeiten"><di:waypoint x="650" y="480" /><di:waypoint x="596" y="490" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Out_Loesung_pruefen_di" bpmnElement="Out_Loesung_pruefen"><di:waypoint x="870" y="210" /><di:waypoint x="873" y="150" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
